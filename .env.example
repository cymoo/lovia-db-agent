# The model (any lovia model id). A bare id goes to an OpenAI-compatible endpoint.
LOVIA_MODEL=openai:gpt-5.5
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1    # with LOVIA_MODEL=deepseek-chat

# One URL per connection in config.yaml (its url_env). Use a read-only account.
DB_DEMO_URL=postgresql+asyncpg://agent_ro:agent_ro@localhost:5432/demo_shop

# Required when serving beyond localhost; open the printed /?token=... link.
# LOVIA_WEB_TOKEN=change-me

# Flag defaults for `lovia-db-agent serve`.
# DB_AGENT_CONFIG=config.yaml
# DB_AGENT_HOST=127.0.0.1
# DB_AGENT_PORT=8000
